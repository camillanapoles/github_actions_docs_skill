{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "igc-envelope-1",
  "title": "Envelope IGC v2.1 (E3)",
  "type": "object",
  "required": [
    "id",
    "status",
    "message",
    "checkpoint_ref"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3,
        4
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_ref": {
      "type": "string",
      "minLength": 7
    },
    "status_label": {
      "type": "string"
    },
    "direction": {
      "type": "string"
    },
    "gate": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "classe": {
      "type": "string",
      "enum": [
        "FIX",
        "CONTINUE",
        "IMPLEMENT",
        "DEBT",
        "HANDOFF"
      ]
    },
    "wal_hash": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "registry": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "wal_entries": {
      "type": [
        "integer",
        "null"
      ]
    },
    "addenda": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "path"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "metrics": {
      "type": "object"
    },
    "next_issue": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
